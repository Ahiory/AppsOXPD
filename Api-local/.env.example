# Ejecucion local
NODE_ENV=development
PORT=3000

# SQL Server local o preproductivo
DB_SERVER=localhost
DB_PORT=1433
DB_INSTANCE=
DB_DATABASE=Carvajal_HP_Presmed_Local
DB_USER=
DB_PASSWORD=

# CORS
# En pruebas locales permite abrir el front desde otro equipo de la misma red.
# En preproduccion usar false y declarar los origenes exactos.
CORS_ALLOW_ALL=true
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# File Server
# mock: genera una respuesta simulada y no almacena archivos.
# real: consume los endpoints configurados abajo.
FILE_SERVER_MODE=mock
FILE_SERVER_BASE_URL=
FILE_SERVER_UPLOAD_PATH=/API/FILESERVER/Upload
# Pendiente confirmar con Coomeva la ruta y el contrato de eliminacion.
FILE_SERVER_DELETE_PATH=
FILE_SERVER_FULLPATH_PREFIX=PruebasCoreInfomedical/SolicitudesAuto
FILE_SERVER_MAX_FILE_SIZE_MB=20

# Datos usados por npm run test:smoke en el ambiente local
SMOKE_API_BASE_URL=http://localhost:3000
SMOKE_ENABLED_USER=JMARQUEZ
SMOKE_DISABLED_USER=USRNOHAB
SMOKE_OPEN_REQUEST=1001001
SMOKE_CLOSED_REQUEST=1001003

