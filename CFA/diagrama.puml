@startuml
!define RECTANGLE class

skinparam componentStyle uml2
skinparam rectangle {
    BackgroundColor<<HP>> #0096D6
    FontColor<<HP>> White
    BackgroundColor<<PHP>> #5C6BC0
    FontColor<<PHP>> White
    BackgroundColor<<Storage>> #E5A91A
    FontColor<<Storage>> White
}

package "Capa de Presentación (Impresora HP con OXPd)" {
    rectangle "Frontend HTML/JS\n(UI Fábrica de Créditos)" as Front <<HP>>
    rectangle "SDK OXPd JS\n(scanService.js)" as SDK <<HP>>
    rectangle "Escáner Físico\n(Hardware OXPd)" as Scan <<HP>>
}

package "Capa de Servidor (Backend PHP) Apache" {
    rectangle "Configuración\n(.env)" as Env <<PHP>>
    rectangle "Receptor HTTP\n(receiver.php)" as API <<PHP>>
}

package "Almacenamiento Local (Red/Windows)" {
    node "Sistema de Archivos SMB\n(poseidon)" as FS <<Storage>>
}

Front --> SDK : Envía 'mapaTxt' (cadena CSV) y config. escaneo
SDK -> Scan : (Endpoint limpio + txtMetadata)
Scan -> API : POST Multipart form-data\n(Archivos .pdf y .txt integrados)

Env .> API : Inyecta variable SAVE_PATH
API -> API : Lee archivo .txt temporal\n(Extrae Oficina y Doc. Identidad)
API --> FS : mkdir()\n(Ruta: poseidon / Oficina / Doc_Identidad /)
API --> FS : move_uploaded_file()\n(Guarda .pdf y .txt)

@enduml