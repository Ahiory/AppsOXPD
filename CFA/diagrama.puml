@startuml
!define RECTANGLE class

skinparam componentStyle uml2
skinparam rectangle {
    BackgroundColor<<HP>> #0096D6
    FontColor<<HP>> White
    BackgroundColor<<PHP>> #5C6BC0
    FontColor<<PHP>> White
    BackgroundColor<<Storage>> #E5A91A
    FontColor<<Storage>> White
}

package "Capa de Presentación (Impresora HP con OXPd)" {
    rectangle "Frontend HTML/JS\n(UI Fábrica de Créditos)" as Front <<HP>>
    rectangle "SDK OXPd JS\n(oxpdscan / oxpddiscovery)" as SDK <<HP>>
    rectangle "Escáner Físico\n(Hardware)" as Scan <<HP>>
}

package "Capa de Servidor (Backend PHP)" {
    rectangle "Receptor HTTP\n(receiver.php)" as API <<PHP>>
    rectangle "Configuración\n(.env)" as Env <<PHP>>
}

package "Almacenamiento Local (Windows)" {
    node "Sistema de Archivos\n(Ej: C:\\Users\\...\\ScanHp\\)" as FS <<Storage>>
}

Front --> SDK : Envía mapaTxt y config de escaneo
SDK <--> Scan : Inicializa ScanTicket\n(PDF + archivo .txt)
Scan --> API : POST Multipart HTTP\n(Parámetro ?doc=)

Env .> API : Inyecta variable SAVE_PATH
API --> FS : mkdir() (Crea carpeta por Doc. Identidad)
API --> FS : move_uploaded_file()\n(Guarda PDF y TXT)

@enduml